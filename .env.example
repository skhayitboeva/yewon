# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="yewon_sms"

# Staff login passwords, each stored as a scrypt hash.
# Generate with:  npm run hash-password -- "your-password-here"
# Login usernames are fixed: admin / manager.
# Students log in separately, by phone number, at /api/student-login.
APP_PASSWORD_HASH_ADMIN="scrypt$...$..."
APP_PASSWORD_HASH_MANAGER="scrypt$...$..."

# Session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Bot token from @BotFather — powers the Telegram Mini App login/link and
# admin broadcast. Get it with /newbot or /mybots > API Token.
TELEGRAM_BOT_TOKEN=""
